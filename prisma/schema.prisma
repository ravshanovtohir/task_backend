// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id        Int    @id @default(autoincrement())
  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String @unique
  password  String

  roles         StaffRole[]
  assignedRoles StaffRole[] @relation("AssignedBy")
  sessions      Session[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(5)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(5)
  deletedAt DateTime? @updatedAt @map("deleted_at") @db.Timestamptz(5)

  @@map("staff")
}

model Role {
  id          Int     @id @default(autoincrement())
  title       Json
  key         String  @unique
  description String?

  staff StaffRole[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(5)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(5)
  deletedAt DateTime? @updatedAt @map("deleted_at") @db.Timestamptz(5)

  @@map("role")
}

model StaffRole {
  id         Int      @id @default(autoincrement())
  roleId     Int      @map("role_id")
  staffId    Int      @map("staff_id")
  assignedBy Int?     @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  role     Role   @relation(fields: [roleId], references: [id])
  staff    Staff  @relation(fields: [staffId], references: [id])
  assigner Staff? @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@map("staff_role")
}

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId          Int      @map("staff_id")
  refreshTokenHash String   @map("refresh_token_hash")
  ipAddress        String   @map("ip_address")
  userAgent        String   @map("user_agent")
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at")

  staff Staff @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(5)

  @@index([staffId, isActive])
  @@map("staff_session")
}
